# En-têtes de Cloudflare Pages (copiés tels quels dans dist/ par expo export).
# Les préversions (*.billets-doux.pages.dev) reçoivent en plus « X-Robots-Tag: noindex » de Pages.
# X-Frame-Options SAMEORIGIN : la version web sur grand écran s'affiche elle-même dans un cadre.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fichiers du build, nommés d'après leur contenu : jamais modifiés, gardés en cache.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/lab*
  X-Robots-Tag: noindex, nofollow
