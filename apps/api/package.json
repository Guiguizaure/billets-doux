{
  "name": "@billets-doux/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3100",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "stockage:preparer": "node scripts/preparer-stockage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@billets-doux/shared": "workspace:*",
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^10.1.0",
    "graphql": "^16.8.1",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.9",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
