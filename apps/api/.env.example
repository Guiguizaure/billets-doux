# Mongo local (docker compose, replica set rs0 exposé sur 27018)
DATABASE_URI=mongodb://127.0.0.1:27018/billets-doux?replicaSet=rs0&directConnection=true
# Secret Payload : `openssl rand -hex 32`
PAYLOAD_SECRET=
# URL publique de l'API
SERVER_URL=http://localhost:3100
# Origines autorisées (séparées par des virgules) : Expo web en local
CORS_ORIGINS=http://localhost:8081
# Production seulement : origine publique de l'API (liens d'invitation) et URL de la version web.
# En développement, elles se déduisent de l'hôte appelé (ex. http://192.168.1.7:3100 et :8081).
PUBLIC_URL=
WEB_URL=
# Schéma de lien de l'appli : billetsdoux (production, par défaut) ou billetsdoux-dev (appli de
# développement, com.webjuno.billetsdoux.dev). En local : billetsdoux-dev.
APP_SCHEME=
# Stockage des médias (API S3). Dev : SeaweedFS de docker-compose. Prod : Cloudflare R2, bucket privé.
S3_ENDPOINT=http://127.0.0.1:8333
# Prod seulement : adresse publique du stockage (en dev, déduite de l'hôte appelé)
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=billets-doux-medias
S3_ACCESS_KEY_ID=billets-doux
S3_SECRET_ACCESS_KEY=billets-doux-local
# Duo de démo (version web) : mot de passe des deux comptes de démo, jamais affiché.
DEMO_MOT_DE_PASSE=
# Production : jeton d'accès Expo (expo.dev → Account settings → Access tokens), pour l'envoi
# des notifications avec la sécurité renforcée des push.
EXPO_ACCESS_TOKEN=
